// Runs every layer against the worktree's Postgres (make test-integration loads .env.local). The test wires
// the layers itself, like cmd/api/routes.go; nothing in api/ proper imports store.
func TestGet__PASCAL__Status_Postgres(t *testing.T) {
	url := os.Getenv("DATABASE_URL")
	if url == "" {
		t.Fatal("DATABASE_URL not set; run make setup, then make test-integration")
	}
	pool, err := db.NewPool(t.Context(), url)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(pool.Close)

	wantStatusOK(t, get(t, service.New(store.New(pool)), "/__KEBAB__/status"))
}
