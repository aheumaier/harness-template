#!/usr/bin/env bash
# Runs in the repo copy: a feat commit under internal/ with no specs/ change (selftest commits the leftover).
set -euo pipefail
echo '# Banner' >internal/BANNER.md
git add internal/BANNER.md
git -c user.name=fixture -c user.email=fixture@localhost -c commit.gpgsign=false -c core.hooksPath=/dev/null \
  commit -qm 'feat(greeting): add a banner'
echo more >>internal/BANNER.md
