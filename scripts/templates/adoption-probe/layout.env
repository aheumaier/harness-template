# What README.md "(b) Brownfield project" step 5 writes into scripts/harness/layout.env for the adoption
# probe's repo (scripts/harness/adoption-probe.sh): a root go.mod, the api set kept, no db, no web.
API_DIR=.
SPEC=api/openapi.yaml
MIGRATIONS_DIR=db/migrations
QUERIES_DIR=db/queries
API_CLIENT_DIR=web/api-client
WEB_GLOBS=web/*
GENERATED_GLOBS=*.gen.go:docs/generated/*
PRODUCT_GLOBS=cmd/*:internal/*:api/*
LAYER_GLOB=internal/*/*
STACK=go
