#!/usr/bin/env bats
# scripts/harness/coverage.sh: coverage per Go package and JS workspace (exec plan 0003 P2.5), a trend, no gate.
bats_require_minimum_version 1.5.0
load helpers

setup() {
  sandbox scripts/harness/coverage.sh
  C="$SANDBOX/scripts/harness/coverage.sh"
  T="$BATS_TEST_TMPDIR"
}

# tsv <file> <row...>: a coverage.tsv, one "<package> <covered> <statements>" argument per row.
tsv() {
  local f="$1" row
  shift
  : >"$f"
  for row in "$@"; do printf '%s\n' "$row" | tr ' ' '\t' >>"$f"; done
}

# fake_tools: go and pnpm stubs on PATH that write the profile and json-summary the real ones would; the
# profile comes from $T/go.out, a failing `go test` from GO_FAIL=1.
fake_tools() {
  mkdir -p "$T/bin"
  cat >"$T/bin/go" <<'EOF'
#!/usr/bin/env bash
case "$1" in
  list) echo example.com/m ;;
  test)
    [[ -z "${GO_FAIL:-}" ]] || { echo "--- FAIL: TestX"; exit 1; }
    for a in "$@"; do [[ "$a" != -coverprofile=* ]] || cp "$FAKE_PROFILE" "${a#-coverprofile=}"; done ;;
esac
EOF
  cat >"$T/bin/pnpm" <<'EOF'
#!/usr/bin/env bash
echo "$*" >>"$PNPM_ARGS"
for a in "$@"; do [[ "$a" != --coverage.reportsDirectory=* ]] || dir="${a#--coverage.reportsDirectory=}"; done
mkdir -p "$dir"
printf '{"total":{"statements":{"total":11,"covered":4,"skipped":0,"pct":36.36}}}\n' >"$dir/coverage-summary.json"
EOF
  chmod +x "$T/bin/go" "$T/bin/pnpm"
  export PATH="$T/bin:$PATH" FAKE_PROFILE="$T/go.out" PNPM_ARGS="$T/pnpm.args"
  mkdir -p "$SANDBOX/apps/api/internal/a" "$SANDBOX/apps/api/internal/b" "$SANDBOX/apps/web" "$SANDBOX/packages/domain"
  printf 'package a\n' >"$SANDBOX/apps/api/internal/a/a.go"
  printf '// Code generated by oapi-codegen. DO NOT EDIT.\n\npackage a\n' >"$SANDBOX/apps/api/internal/a/api.gen.go"
  printf 'package b\n' >"$SANDBOX/apps/api/internal/b/b.go"
  printf '{"scripts":{"coverage":"vitest run --coverage"}}\n' >"$SANDBOX/apps/web/package.json"
  printf '{"scripts":{"typecheck":"tsc"}}\n' >"$SANDBOX/packages/domain/package.json"
  cat >"$T/go.out" <<'EOF'
mode: set
example.com/m/internal/a/a.go:3.1,4.2 3 1
example.com/m/internal/a/a.go:5.1,6.2 1 0
example.com/m/internal/a/api.gen.go:3.1,9.2 50 0
example.com/m/internal/b/b.go:3.1,4.2 2 0
example.com/m/internal/b/b.go:3.1,4.2 2 1
EOF
}

@test "report: statement coverage per package, workspaces without tests marked, no change column" {
  tsv "$T/cur.tsv" "apps/api/... 3 4" "apps/api/x 3 4" "apps/web 4 11" "packages/domain - -"
  run -0 "$C" report "$T/cur.tsv"
  has '| Package | Statements | Coverage |'
  has '| apps/api/x | 4 | 75.0% |'
  has '| apps/web | 11 | 36.4% |'
  has '| packages/domain |  | no tests |'
  run ! has 'Change'
  # make coverage passes an empty COVERAGE_PREVIOUS as an empty second argument.
  run -0 "$C" report "$T/cur.tsv" ""
  has '| Package | Statements | Coverage |'
  run ! has 'Change'
}

@test "report with a previous file: change in percentage points, new packages marked" {
  tsv "$T/prev.tsv" "apps/api/x 2 4" "apps/web 4 11"
  tsv "$T/cur.tsv" "apps/api/x 3 4" "apps/api/y 1 2" "apps/web 4 11" "packages/domain - -"
  run -0 "$C" report "$T/cur.tsv" "$T/prev.tsv"
  has '| Package | Statements | Coverage | Change (pp) |'
  has '| apps/api/x | 4 | 75.0% | +25.0 |'
  has '| apps/api/y | 2 | 50.0% | new |'
  has '| apps/web | 11 | 36.4% | 0.0 |'
  has '| packages/domain |  | no tests |  |'
}

@test "report --fell: only the packages whose coverage fell, nothing when none did" {
  tsv "$T/prev.tsv" "apps/api/x 3 4" "apps/web 4 11" "packages/domain 1 2"
  tsv "$T/cur.tsv" "apps/api/x 2 4" "apps/web 5 11" "packages/domain - -"
  run -0 "$C" report --fell "$T/cur.tsv" "$T/prev.tsv"
  has '### Coverage fell'
  has '| apps/api/x | 4 | 50.0% | -25.0 |'
  has '| packages/domain |  | no tests | -50.0 |'
  run ! has 'apps/web'
  run -0 "$C" report --fell "$T/prev.tsv" "$T/prev.tsv"
  [ -z "$output" ]
}

@test "report fails closed on unparseable, empty or missing input and on bad usage" {
  tsv "$T/ok.tsv" "apps/web 4 11"
  printf 'apps/web 4 eleven\n' >"$T/bad.tsv"
  : >"$T/empty.tsv"
  run -2 "$C" report "$T/bad.tsv"
  has 'unparseable coverage file'
  run -2 "$C" report "$T/ok.tsv" "$T/bad.tsv"
  run -2 "$C" report "$T/empty.tsv"
  run -2 "$C" report "$T/missing.tsv"
  run -2 "$C" report --fell "$T/ok.tsv"
  run -2 "$C" report
  run -2 "$C" nope
}

@test "collect: Go packages without generated files, each block once, their sum, then the JS workspaces" {
  fake_tools
  run -0 "$C" collect "$T/out"
  [ -z "$output" ]
  run -0 cat "$T/out/coverage.tsv"
  [ "$output" = "$(printf 'apps/api/...\t5\t6\napps/api/internal/a\t3\t4\napps/api/internal/b\t2\t2\napps/web\t4\t11\npackages/domain\t-\t-')" ]
  # The measurement (provider, reporter) is fixed by coverage.sh, not by the workspace's config.
  run -0 cat "$PNPM_ARGS"
  has '--coverage.provider=v8 --coverage.reporter=json-summary --coverage.reportsDirectory='
}

@test "collect fails with a remediation for a workspace with tests but no coverage script" {
  fake_tools
  mkdir -p "$SANDBOX/packages/api-client"
  printf '{"scripts":{"test":"vitest run"}}\n' >"$SANDBOX/packages/api-client/package.json"
  run -2 "$C" collect "$T/out"
  has 'packages/api-client has a test script but no coverage script'
  has '"coverage": "vitest run --coverage"'
}

@test "collect fails with the test output when go test fails, and closed on an unparseable profile" {
  fake_tools
  GO_FAIL=1 run -1 "$C" collect "$T/out"
  has '--- FAIL: TestX'
  has 'go test failed in apps/api'
  printf 'mode: set\nnot a profile line\n' >"$T/go.out"
  run -2 "$C" collect "$T/out"
  has 'unparseable Go coverage profile'
}
