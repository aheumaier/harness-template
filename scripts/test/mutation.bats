#!/usr/bin/env bats
# scripts/harness/mutation.sh: mutation score of the recently changed files (ADR 0023), a trend, no gate.
bats_require_minimum_version 1.5.0
load helpers

# Commits get fixed dates and every call a fixed <since>, so no test reads the clock.
OLD=2020-01-01T00:00:00Z
SINCE=2020-03-01
NEW=2020-06-01T00:00:00Z

setup() {
  sandbox scripts/harness/mutation.sh scripts/harness/gremlins.yaml
  M="$SANDBOX/scripts/harness/mutation.sh"
  T="$BATS_TEST_TMPDIR"
}

# commit <date> <message>: commits everything in $SANDBOX as of <date>.
commit() {
  git -C "$SANDBOX" add -A
  GIT_AUTHOR_DATE="$1" GIT_COMMITTER_DATE="$1" git -C "$SANDBOX" -c user.name=test -c user.email=test@localhost \
    -c commit.gpgsign=false commit -qm "$2"
}

# put <path> [content]: writes a sandbox file.
put() {
  mkdir -p "$SANDBOX/$(dirname "$1")"
  printf '%s\n' "${2:-x}" >"$SANDBOX/$1"
}

# tsv <file> <row...>: a mutants.tsv, one "<package> <location> <mutator> <status>" argument per row.
tsv() {
  local f="$1" row
  shift
  : >"$f"
  for row in "$@"; do printf '%s\n' "$row" | tr ' ' '\t' >>"$f"; done
}

# fake_tools: gremlins and pnpm stubs on PATH that write the json reports the real ones would (from
# $T/gremlins.json and $T/stryker.json) and record their arguments, the GREMLINS_* variables and GOFLAGS they
# see; FAKE_GREMLINS_FAIL=1 / FAKE_PNPM_FAIL=<output> fail them. Their own variables are not GREMLINS_*: the
# script unsets those. The sandbox: a changed Go file next to an unchanged one, a test and a generated file;
# apps/web with a mutation script, packages/domain without tests.
fake_tools() {
  mkdir -p "$T/bin"
  cat >"$T/bin/gremlins" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$@" >"$FAKE_GREMLINS_ARGS"
{ env | grep '^GREMLINS_' || true; echo "GOFLAGS=${GOFLAGS:-}"; } >"$FAKE_GREMLINS_ENV"
[[ -z "${FAKE_GREMLINS_FAIL:-}" ]] || { echo "--- FAIL: TestA"; exit 1; }
while (($#)); do [[ "$1" != --output ]] || cp "$FAKE_GREMLINS" "$2"; shift; done
EOF
  cat >"$T/bin/pnpm" <<'EOF'
#!/usr/bin/env bash
echo "$*" >>"$FAKE_PNPM_ARGS"
[[ -z "${FAKE_PNPM_FAIL:-}" ]] || { echo "$FAKE_PNPM_FAIL"; exit 1; }
mkdir -p reports/mutation
cp "$FAKE_STRYKER" reports/mutation/mutation.json
EOF
  chmod +x "$T/bin/gremlins" "$T/bin/pnpm"
  export PATH="$T/bin:$PATH" FAKE_GREMLINS="$T/gremlins.json" FAKE_STRYKER="$T/stryker.json" \
    FAKE_GREMLINS_ARGS="$T/gremlins.args" FAKE_GREMLINS_ENV="$T/gremlins.env" FAKE_PNPM_ARGS="$T/pnpm.args"
  put apps/api/go.mod 'module example.com/m'
  put apps/api/internal/b/b.go 'package b'
  commit "$OLD" old
  put apps/api/internal/a/a.go 'package a'
  put apps/api/internal/a/a_test.go 'package a'
  put apps/api/internal/a/api.gen.go '// Code generated by oapi-codegen. DO NOT EDIT.'
  put apps/web/package.json '{"scripts":{"test":"vitest run","mutation":"stryker run"}}'
  put apps/web/stryker.config.json '{"testRunner":"vitest"}'
  put apps/web/src/App.tsx
  put packages/domain/package.json '{"scripts":{"typecheck":"tsc"}}'
  put packages/domain/src/index.ts
  commit "$NEW" new
  cat >"$T/gremlins.json" <<'EOF'
{"go_module":"example.com/m","files":[{"file_name":"internal/a/a.go","mutations":[
{"type":"CONDITIONALS_NEGATION","status":"LIVED","line":3,"column":5},
{"type":"ARITHMETIC_BASE","status":"KILLED","line":4,"column":2},
{"type":"INCREMENT_DECREMENT","status":"NOT COVERED","line":5,"column":1},
{"type":"INVERT_NEGATIVES","status":"NOT VIABLE","line":6,"column":1}]}]}
EOF
  cat >"$T/stryker.json" <<'EOF'
{"schemaVersion":"1","thresholds":{"high":80,"low":60},"files":{"src/App.tsx":{"language":"typescript","source":"","mutants":[
{"id":"1","mutatorName":"ConditionalExpression","status":"Survived","location":{"start":{"line":7,"column":7},"end":{"line":7,"column":9}}},
{"id":"2","mutatorName":"StringLiteral","status":"Killed","location":{"start":{"line":8,"column":1},"end":{"line":8,"column":3}}}]}}}
EOF
}

@test "files: changed, still existing, mutable source only; tests, generated, nested modules and src/gen are not" {
  put apps/api/go.mod 'module example.com/m'
  put apps/api/internal/old/old.go 'package old'
  commit "$OLD" old
  put apps/api/internal/a/a.go 'package a'
  put apps/api/internal/a/a_test.go 'package a'
  put apps/api/internal/a/testdata/t.go 'package t'
  put apps/api/internal/a/api.gen.go '// Code generated by oapi-codegen. DO NOT EDIT.'
  put apps/api/tools/harness/go.mod 'module example.com/tools'
  put apps/api/tools/harness/main.go 'package main'
  put apps/web/src/App.tsx
  put apps/web/src/App.test.tsx
  put apps/web/src/vite-env.d.ts
  put apps/web/src/gone.ts
  put apps/web/vite.config.ts
  put packages/api-client/src/client.ts
  put packages/api-client/src/gen/schema.ts
  put packages/domain/src/index.spec.ts
  put README.md
  commit "$NEW" new
  rm "$SANDBOX/apps/web/src/gone.ts"
  commit "$NEW" delete
  run -0 "$M" files "$SINCE"
  [ "$output" = "$(printf 'apps/api\tapps/api/internal/a/a.go\napps/web\tapps/web/src/App.tsx\npackages/api-client\tpackages/api-client/src/client.ts')" ]
  # The window: before the first commit, all of HEAD is in scope.
  run -0 "$M" files 2019-01-01
  has 'apps/api/internal/old/old.go'
}

@test "files: a branch committed before <since> and merged after it is in scope (first-parent tree diff)" {
  put README.md
  commit 2019-06-01T00:00:00Z base
  main="$(git -C "$SANDBOX" rev-parse --abbrev-ref HEAD)"
  git -C "$SANDBOX" checkout -qb feature
  put apps/web/src/feature.ts
  commit "$OLD" one
  put apps/web/src/other.ts
  commit "$OLD" two
  git -C "$SANDBOX" checkout -q "$main"
  GIT_AUTHOR_DATE="$NEW" GIT_COMMITTER_DATE="$NEW" git -C "$SANDBOX" -c user.name=test -c user.email=test@localhost \
    -c commit.gpgsign=false merge -q --no-ff -m merge feature
  run -0 "$M" files "$SINCE"
  [ "$output" = "$(printf 'apps/web\tapps/web/src/feature.ts\napps/web\tapps/web/src/other.ts')" ]
}

@test "files fails closed on a shallow clone and on an unexpected source file name, not on other names" {
  put apps/web/src/App.tsx
  commit "$NEW" one
  put apps/web/src/b.ts
  commit "$NEW" two
  git clone -q --depth 1 "file://$SANDBOX" "$T/shallow"
  run -2 "$T/shallow/scripts/harness/mutation.sh" files "$SINCE"
  has 'shallow clone'
  has 'fetch-depth: 0'
  # Route files of the web app ($ and [] in their names) and a non-source file with a space are fine.
  put 'apps/web/src/routes/$id.tsx'
  put 'apps/web/src/routes/[slug].tsx'
  put 'docs/a b.md'
  commit "$NEW" routes
  run -0 "$M" files "$SINCE"
  has 'apps/web/src/routes/$id.tsx'
  has 'apps/web/src/routes/[slug].tsx'
  run ! has 'a b.md'
  put 'apps/web/src/a b.ts'
  commit "$NEW" space
  run -2 "$M" files "$SINCE"
  has 'unexpected file name apps/web/src/a b.ts: rename it'
}

@test "report: score per package, workspaces without tests marked, invalid mutants not counted, survivors listed" {
  tsv "$T/m.tsv" \
    "apps/api apps/api/a.go:3:5 CONDITIONALS_NEGATION survived" \
    "apps/api apps/api/a.go:4:2 ARITHMETIC_BASE killed" \
    "apps/api apps/api/b.go:1:1 ARITHMETIC_BASE timeout" \
    "apps/api apps/api/b.go:2:1 INVERT_NEGATIVES nocoverage" \
    "apps/api apps/api/b.go:3:1 INVERT_NEGATIVES invalid" \
    "apps/web apps/web/src/x.ts:1:1 StringLiteral invalid" \
    "packages/domain packages/domain/src/index.ts - notests"
  run -0 "$M" report "$T/m.tsv" "$SINCE"
  has "### Mutation testing of the files changed since $SINCE (a trend, not a gate)"
  has '| Package | Files with mutants | Mutants | Killed | Timed out | Survived | No coverage | Score |'
  has '| apps/api | 2 | 4 | 1 | 1 | 1 | 1 | 50.0% |'
  has '| apps/web | 1 | 0 | 0 | 0 | 0 | 0 | no mutants |'
  has '| packages/domain |  |  |  |  |  |  | no tests (1 files) |'
  has '#### Surviving mutants (1)'
  has '- `apps/api/a.go:3:5`: CONDITIONALS_NEGATION'
  tsv "$T/dead.tsv" "apps/web apps/web/src/x.ts:1:1 StringLiteral killed"
  run -0 "$M" report "$T/dead.tsv" "$SINCE"
  run ! has 'Surviving'
  : >"$T/empty.tsv"
  run -0 "$M" report "$T/empty.tsv" "$SINCE"
  has 'No mutable Go or TypeScript source file changed.'
}

@test "report fails closed on unparseable or missing input and on bad usage" {
  tsv "$T/ok.tsv" "apps/web apps/web/src/x.ts:1:1 StringLiteral killed"
  tsv "$T/status.tsv" "apps/web apps/web/src/x.ts:1:1 StringLiteral dead"
  tsv "$T/cols.tsv" "apps/web apps/web/src/x.ts:1:1 killed"
  tsv "$T/name.tsv" "apps/web apps/web/src/a\$(x).ts:1:1 StringLiteral killed"
  run -2 "$M" report "$T/status.tsv" "$SINCE"
  has 'unparseable mutants file'
  run -2 "$M" report "$T/cols.tsv" "$SINCE"
  run -2 "$M" report "$T/name.tsv" "$SINCE"
  run -2 "$M" report "$T/missing.tsv" "$SINCE"
  has 'run make mutation'
  run -2 "$M" report "$T/ok.tsv"
  run -2 "$M" files
  run -2 "$M" collect "$T/out"
  run -2 "$M" nope
}

@test "collect: gremlins on the changed Go files with the protected config, Stryker on the changed TS files, one sorted mutants.tsv" {
  fake_tools
  export GREMLINS_UNLEASH_THRESHOLD_EFFICACY=99 GOFLAGS=-race
  run -0 "$M" collect "$T/out" "$SINCE"
  [ -z "$output" ]
  tsv "$T/want.tsv" \
    "apps/api apps/api/internal/a/a.go:3:5 CONDITIONALS_NEGATION survived" \
    "apps/api apps/api/internal/a/a.go:4:2 ARITHMETIC_BASE killed" \
    "apps/api apps/api/internal/a/a.go:5:1 INCREMENT_DECREMENT nocoverage" \
    "apps/api apps/api/internal/a/a.go:6:1 INVERT_NEGATIVES invalid" \
    "apps/web apps/web/src/App.tsx:7:7 ConditionalExpression survived" \
    "apps/web apps/web/src/App.tsx:8:1 StringLiteral killed" \
    "packages/domain packages/domain/src/index.ts - notests"
  run -0 diff "$T/want.tsv" "$T/out/mutants.tsv"
  # gremlins mutates a module: every other Go file of it is excluded, as an anchored, escaped regex. What it
  # measures comes from scripts/harness/gremlins.yaml alone, with the test set of make test-go.
  run -0 cat "$FAKE_GREMLINS_ARGS"
  has "$(printf -- '--config\n%s/scripts/harness/gremlins.yaml' "$SANDBOX")"
  has '^internal/b/b\.go$'
  has '^internal/a/a_test\.go$'
  has '^internal/a/api\.gen\.go$'
  run ! has '^internal/a/a\.go$'
  run -0 cat "$FAKE_GREMLINS_ENV"
  [ "$output" = 'GOFLAGS=-short' ]
  run -0 cat "$FAKE_PNPM_ARGS"
  [ "$output" = 'run --silent mutation stryker.config.json --mutate src/App.tsx --reporters json --cleanTempDir always' ]
  # The report is moved out of the workspace.
  [ -f "$T/out/ws/apps_web.json" ]
  [ ! -e "$SANDBOX/apps/web/reports" ]
  run -0 "$M" report "$T/out/mutants.tsv" "$SINCE"
  has '| apps/api | 1 | 3 | 1 | 0 | 1 | 1 | 33.3% |'
  has '| apps/web | 1 | 2 | 1 | 0 | 1 | 0 | 50.0% |'
}

@test "collect: several TS files are one comma-separated --mutate with [ ] escaped; nothing changed runs no tool" {
  fake_tools
  put apps/web/src/b.ts
  put 'apps/web/src/routes/[id].tsx'
  commit "$NEW" more
  run -0 "$M" collect "$T/out" "$SINCE"
  run -0 cat "$FAKE_PNPM_ARGS"
  has '--mutate src/App.tsx,src/b.ts,src/routes/\[id\].tsx '
  rm -f "$FAKE_GREMLINS_ARGS" "$FAKE_PNPM_ARGS"
  run -0 "$M" collect "$T/later" 2021-01-01
  [ -f "$T/later/mutants.tsv" ] && [ ! -s "$T/later/mutants.tsv" ]
  [ ! -e "$FAKE_GREMLINS_ARGS" ] && [ ! -e "$FAKE_PNPM_ARGS" ]
}

@test "collect fails with a remediation for a missing tool and a workspace not set up for Stryker" {
  mkdir -p "$T/only"
  ln -s "$(command -v bash)" "$(command -v dirname)" "$T/only/"
  PATH="$T/only" run -2 "$M" collect "$T/out" "$SINCE"
  has 'gremlins not found: run make setup'
  fake_tools
  put packages/api-client/package.json '{"scripts":{"test":"vitest run"}}'
  put packages/api-client/src/client.ts
  commit "$NEW" client
  run -2 "$M" collect "$T/out" "$SINCE"
  has 'packages/api-client has a test script but no mutation script'
  has '"mutation": "stryker run"'
  has '@stryker-mutator/vitest-runner'
  has 'stryker.config.json copied from apps/web'
  rm "$SANDBOX/packages/api-client/package.json"
  FAKE_PNPM_FAIL='sh: stryker: command not found' run -2 "$M" collect "$T/out" "$SINCE"
  has 'apps/web cannot run stryker: add "mutation": "stryker run"'
  rm "$SANDBOX/apps/web/stryker.config.json"
  run -2 "$M" collect "$T/out" "$SINCE"
  has 'apps/web has no stryker.config.json'
}

@test "collect fails closed on a loosened stryker config and on a package.json it cannot read" {
  fake_tools
  put apps/web/stryker.config.json '{"thresholds":{"break":50},"excludedMutations":["StringLiteral"]}'
  run -2 "$M" collect "$T/out" "$SINCE"
  has 'apps/web/stryker.config.json sets thresholds.break, excludedMutations'
  put apps/web/stryker.config.json '{'
  run -2 "$M" collect "$T/out" "$SINCE"
  has 'unparseable apps/web/stryker.config.json'
  put apps/web/stryker.config.json '{"testRunner":"vitest"}'
  put packages/domain/package.json '{"scripts":'
  run -2 "$M" collect "$T/out" "$SINCE"
  has 'cannot read packages/domain/package.json'
}

@test "collect fails with the test output when a run fails, and closed on an unparseable report or a file outside the selection" {
  fake_tools
  FAKE_GREMLINS_FAIL=1 run -1 "$M" collect "$T/out" "$SINCE"
  has '--- FAIL: TestA'
  has 'gremlins failed in apps/api (cd apps/api && go test -short ./...'
  FAKE_PNPM_FAIL='FAIL src/App.test.tsx' run -1 "$M" collect "$T/out" "$SINCE"
  has 'FAIL src/App.test.tsx'
  has 'pnpm run mutation failed in apps/web'
  printf '{"files":[{"file_name":"internal/b/b.go","mutations":[]}]}\n' >"$T/gremlins.json"
  run -2 "$M" collect "$T/out" "$SINCE"
  has 'a file outside the selection: apps/api/internal/b/b.go'
  printf '{"files":[{"file_name":"internal/a/a.go","mutations":[{"type":"X","status":"MAYBE","line":1,"column":1}]}]}\n' >"$T/gremlins.json"
  run -2 "$M" collect "$T/out" "$SINCE"
  has 'unparseable gremlins report'
  printf 'not json\n' >"$T/stryker.json"
  printf '{"files":[]}\n' >"$T/gremlins.json"
  run -2 "$M" collect "$T/out" "$SINCE"
  has 'unparseable Stryker report'
}
