TRIVY_SHA256_LINUX_AMD64=e24b1c51293c1b15e4ba8d45bbc7891ba053f90278ec2698f3562c993e145fe7
# Parses the observability stack's JSON for make logs/metrics/traces (ADR 0017). Pins match the release's
# sha256sum.txt and GitHub's asset digests.
JQ_VERSION=1.8.2
JQ_SHA256_DARWIN_ARM64=2d75340ba57a4b4b4c8708a21c2dc8e958a48aaa8bba13b27f77f6e4c0eca07e
JQ_SHA256_DARWIN_AMD64=e94b266e3c26690550006abe63152b782280f4e14374accdf04cbde844f00bc0
JQ_SHA256_LINUX_ARM64=8b85c817833814ddca00a144c33705546355afccf0cf39b188f3cdb48b852309
JQ_SHA256_LINUX_AMD64=b1c22172dd303f3be49e935aa56aa48a8b7a46e0bc838b4997d3bb451495870f
# Sensors of the go and db groups that used to come from package.json: a stack without web installs no pnpm
# (ADR 0033). The versions are the ones package.json pinned. Spectral (lint-api) and squawk (db) pins match
# GitHub's asset digests; bats (test-sh) is the npm registry's tarball, arch-independent, whose sha512 matched
# the integrity pnpm-lock.yaml recorded for bats@1.13.0.
SPECTRAL_VERSION=v6.17.0
SPECTRAL_SHA256_DARWIN_ARM64=cb7e1bd31d85a9920100d79e7ba138cc75cf529dfa8e7492c69affe52e38d142
SPECTRAL_SHA256_DARWIN_AMD64=5664d1c7eafae8989613632ba434f75e18d5dcc2d3840ed72b3ed57678c8c46d
SPECTRAL_SHA256_LINUX_ARM64=27eb1c2880dba43c9cbebb5d10bfbacd7d359428b64dd0d9659cf5e406808503
SPECTRAL_SHA256_LINUX_AMD64=e6244baecff57dfb89ba8379a09563270fbb4ac7f73fb8692510a6160059ec53
SQUAWK_VERSION=v2.70.0
SQUAWK_SHA256_DARWIN_ARM64=6d96c07032109202a43802e212b2c592d48a11b208d661b2c8814a7eca4a984a
SQUAWK_SHA256_DARWIN_AMD64=0369f5cc2beb7e224952d5d30068a92f9e23d65af99d7e7565c9a4fda916c379
SQUAWK_SHA256_LINUX_ARM64=fdb1ceff1d45252ccce44be8888d45a45206ba901804713124b0aa6eacc92e0e
SQUAWK_SHA256_LINUX_AMD64=836ba2ab0c0ec30ae02c9f2cec065b341ff853765ceaa3965c22109c2f53eb1c
BATS_VERSION=1.13.0
BATS_SHA256=b7ae290dbc7e44709d5e3430698f3048a978bef871c6063f5fca49a20e5aaf58
# CI only: the advisory PR reviewer (.github/workflows/pr-review.yml) via `install-tools.sh claude`, never
# `make tools`. 2.1.300 was released 2026-10-14 (past the 14-day age rule, ADR 0016). Pins match the sha256
# values in the release's manifest.json and the downloaded binaries (exec plan 0003 P3.2); the manifest's
# signature is not verified. On a bump, check that the CLAUDE_CODE_DISABLE_* variables the workflows set still
# exist in the new binary: the CLI ignores an unknown one, so a rename drops its guard silently (ADR 0040).
CLAUDE_CODE_VERSION=2.1.300
CLAUDE_CODE_SHA256_DARWIN_ARM64=475517caa611e3318a2f298fa071287ec98955538df78c58f709ecc01e5ae2d3
CLAUDE_CODE_SHA256_DARWIN_AMD64=5824fc36863e70bbd070491bb9359e217d3f17b38c45697c085b31a3a67356b3
CLAUDE_CODE_SHA256_LINUX_ARM64=ae2295ae2da156936bf5831ab01971ce924d0c9a0af174e28d96fffa8d5fa0a6
CLAUDE_CODE_SHA256_LINUX_AMD64=674deba0bba9aee479f4503c438b49303b6fdd304b9a471b14977aaec5215453
# The ios group (ADR 0043): macOS only, installed only with ios in STACK. SwiftLint's portable zip is one universal
# binary, so one pin for both arches; it matches GitHub's asset digest. 0.65.1 was released 2026-08-21.
SWIFTLINT_VERSION=0.65.1
SWIFTLINT_SHA256_DARWIN=c1e429b0599cf1b516f369a2d9ec04eaf0e436f3c12b637df8851fa52ff694d0
# swift-format publishes no binaries: built from source at this tag commit (git checks the commit hash), its
# dependencies at the revisions in scripts/swift-format/Package.resolved (each its release tag's commit). 604.0.0 was
# released 2026-09-16; the dependencies' releases are older than 2026-10-18 (14-day age rule, ADR 0016). A bump
# changes the version, the commit and the resolved file together, each revision checked against that rule (ADR 0043).
SWIFT_FORMAT_VERSION=604.0.0
SWIFT_FORMAT_COMMIT=15d7877c6b32926948f6520f0156657945955ea3
# Xcode for the iOS sensors that need it (make xcode-pinned, check-ios): the default Xcode of GitHub's macos-26
# arm64 runner image (images/macos/macos-26-arm64-Readme.md, image 20261026.0455.2; ADR 0043).
XCODE_VERSION=26.6
# XcodeGen generates the iOS app's Xcode project from IOS_DIR/project.yml (make build-ios, ADR 0044): installed on
# demand by `install-tools.sh xcodegen` where Xcode is selected, never by `make tools`. Its release zip holds one
# universal binary, so one pin for both arches; it matches GitHub's asset digest. 2.46.0 was released 2026-07-16.
XCODEGEN_VERSION=2.46.0
XCODEGEN_SHA256_DARWIN=4d9e34b62172d645eed6457cac13fc222569974098ef4ee9c3368bedf0196806
SHFMT_VERSION=v3.14.1
ACTIONLINT_VERSION=v1.7.12
PNPM_VERSION=12.15.0
# CI only (actions/setup-node); locally any Node matching package.json "engines".
NODE_VERSION=24.9.0
# Images with a persistent volume are frozen per worktree: setup-worktree.sh copies POSTGRES_IMAGE into
# .env.local once, so a bump reaches new worktrees and never upgrades an existing data volume in place.
POSTGRES_IMAGE=postgres:17-alpine
# Images without one are read live (ADR 0017): per-worktree logs, metrics and traces (compose profile obs),
# name:tag@index-digest, read from here by make and setup-worktree.sh, so a bump reaches every worktree.
OBS_IMAGE=grafana/otel-lgtm:0.36.0@sha256:57c04cbd8e7022f32bb84c4ac005d79baf8b08e2c5be44facf11f5f1f9944ba2
# Mutation testing (make mutation, drift.yml; exec plan 0003 P2.6), built with go install like the Go tools above.
GREMLINS_VERSION=v0.6.0
# Template sync (make harness-sync-check, drift.yml; exec plan 0003 P4.3, ADR 0026): the git URL of the template
# this repo was cut from; .harness-version holds the template commit whose harness files it last took. Empty
# means this repository is the template; make rename writes the template's URL (a brownfield adoption by hand).
HARNESS_UPSTREAM=
